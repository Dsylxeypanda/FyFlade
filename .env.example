# FyFlade already embeds its official public Google Desktop OAuth client ID.
# Only copy this file to .env.production.local when intentionally overriding it
# for a separate release/test client. Never ask end users to configure this.
VITE_YOUTUBE_OAUTH_CLIENT_ID=replace-with-fyflade-desktop-client-id.apps.googleusercontent.com

# Google documents client_secret as optional for installed/desktop apps using
# PKCE. Leave this empty unless the configured Google client specifically needs it.
VITE_YOUTUBE_OAUTH_CLIENT_SECRET=
