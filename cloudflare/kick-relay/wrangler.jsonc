{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatnest-kick-relay",
  "account_id": "bdfd83dd76b59e5c0c93c5bec6d25ab8",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "KICK_REDIRECT_URI": "http://localhost:17171/kick/callback",
    "KICK_CLIENT_ID": "01M0BMQ63HVJ2Q2D40N8K4NQ2K",
    "CHATNEST_UPDATE_VERSION": "1.0.0",
    "CHATNEST_UPDATE_NOTES": "FyFlade 1.0 – first public release."
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/config",
      "/updates-v1/*",
      "/usage*",
      "/oauth/*",
      "/kick/*",
      "/relay*"
    ]
  },
  "ratelimits": [
    {
      "name": "ANONYMOUS_USAGE_RATE_LIMITER",
      "namespace_id": "9001001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_HUB",
        "class_name": "ChatHub"
      }
    ]
  },
  "exports": {
    "ChatHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
